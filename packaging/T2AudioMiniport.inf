[Version]
Signature="$WINDOWS NT$"
Class=Media
ClassGuid={4D36E96C-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=10/05/2026,1.0.0.0
CatalogFile=T2AudioMiniport.cat

[Manufacturer]
%ProviderName%=Standard,NTamd64

[Standard.NTamd64]
