[Version]
Signature="$WINDOWS NT$"
Class=Media
ClassGuid={4D36E96C-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=10/29/2026,1.0.13.10
CatalogFile=T2AudioMiniport.cat

[Manufacturer]
%ProviderName%=Standard,NTamd64

[Standard.NTamd64]
%T2Audio.DeviceDesc%=T2Audio_Install,PCI\VEN_106B&DEV_1803&SUBSYS_1887106B&REV_01

[T2Audio_Install.NT]
; Standard audio-driver registration (KS + wdmaudio), as in the WDK samples.
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=T2Audio_CopyFiles

[T2Audio_Install.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Wave%,T2Audio.Wave
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_Wave%,T2Audio.Wave
; A WaveRT wave filter must also be registered as KSCATEGORY_REALTIME.
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_Wave%,T2Audio.Wave
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Topology%,T2Audio.Topology
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_Topology%,T2Audio.Topology
; Headphone endpoint (Parameters\HeadphoneOutput=1). The interfaces only
; become active when the driver registers these subdevices.
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveHeadphone%,T2Audio.WaveHeadphone
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_WaveHeadphone%,T2Audio.WaveHeadphone
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveHeadphone%,T2Audio.WaveHeadphone
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyHeadphone%,T2Audio.TopologyHeadphone
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyHeadphone%,T2Audio.TopologyHeadphone
; Built-in microphones (Parameters\MicInput=1).
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveMic%,T2Audio.WaveMic
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_WaveMic%,T2Audio.WaveMic
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveMic%,T2Audio.WaveMic
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyMic%,T2Audio.TopologyMic
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyMic%,T2Audio.TopologyMic

[T2Audio.Wave]
AddReg=T2Audio.Wave.AddReg

[T2Audio.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%T2Audio.Wave.FriendlyName%

[T2Audio.Topology]
AddReg=T2Audio.Topology.AddReg

[T2Audio.Topology.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%T2Audio.Topology.FriendlyName%

[T2Audio.WaveHeadphone]
AddReg=T2Audio.WaveHeadphone.AddReg

[T2Audio.WaveHeadphone.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%T2Audio.WaveHeadphone.FriendlyName%

[T2Audio.TopologyHeadphone]
AddReg=T2Audio.TopologyHeadphone.AddReg

[T2Audio.TopologyHeadphone.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%T2Audio.TopologyHeadphone.FriendlyName%

[T2Audio.WaveMic]
AddReg=T2Audio.WaveMic.AddReg

[T2Audio.WaveMic.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%T2Audio.WaveMic.FriendlyName%

[T2Audio.TopologyMic]
AddReg=T2Audio.TopologyMic.AddReg

[T2Audio.TopologyMic.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%T2Audio.TopologyMic.FriendlyName%

[T2Audio_Install.NT.Services]
Include=wdmaudio.inf
Needs=WDMAUDIO.Registration.NT.Services
AddService=T2AudioMiniport,0x00000002,T2Audio_Service

[T2Audio_Service]
DisplayName=%T2Audio.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\T2AudioMiniport.sys

[T2Audio_CopyFiles]
T2AudioMiniport.sys

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
T2AudioMiniport.sys=1

[DestinationDirs]
DefaultDestDir=12

[Strings]
DiskName="T2 Audio Driver Installation Disk"
ProviderName="T2AudioPort"
T2Audio.DeviceDesc="Apple T2 Audio Device (6-channel Native Driver)"
T2Audio.ServiceDesc="T2 Audio PortCls Miniport Driver"
T2Audio.Wave.FriendlyName="T2 Audio Speaker"
T2Audio.Topology.FriendlyName="T2 Audio Topology"
T2Audio.WaveHeadphone.FriendlyName="T2 Audio Headphones"
T2Audio.TopologyHeadphone.FriendlyName="T2 Audio Headphone Topology"
T2Audio.WaveMic.FriendlyName="T2 Audio Microphone"
T2Audio.TopologyMic.FriendlyName="T2 Audio Microphone Topology"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNAME_Wave="Wave"
KSNAME_Topology="Topology"
KSNAME_WaveHeadphone="WaveHeadphone"
KSNAME_TopologyHeadphone="TopologyHeadphone"
KSNAME_WaveMic="WaveMic"
KSNAME_TopologyMic="TopologyMic"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
